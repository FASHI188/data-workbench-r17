{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-workbench-r17.local/schemas/extension_module_manifest_v1.schema.json",
  "title": "Extension Module Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_id",
    "module_version",
    "contract_version",
    "kind",
    "lifecycle",
    "enabled",
    "dependencies",
    "training_allowed",
    "live_allowed",
    "failure_policy",
    "fallback_behavior",
    "timeout_seconds",
    "max_retries"
  ],
  "properties": {
    "module_id": {"type": "string", "minLength": 1},
    "module_version": {"type": "string", "minLength": 1},
    "contract_version": {"type": "string", "minLength": 1},
    "kind": {
      "enum": [
        "SOURCE_ADAPTER",
        "FEATURE_PLUGIN",
        "MODEL_ADAPTER",
        "TASK_SCHEDULER",
        "EVENT_LOG",
        "OUTPUT_ADAPTER",
        "ENTITY_RESOLVER"
      ]
    },
    "lifecycle": {
      "enum": [
        "REGISTERED",
        "SHADOW",
        "TESTED",
        "ACCEPTED",
        "ENABLED",
        "DISABLED",
        "QUARANTINED",
        "ROLLED_BACK"
      ]
    },
    "enabled": {"type": "boolean"},
    "input_schema": {"type": ["string", "null"]},
    "output_schema": {"type": ["string", "null"]},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "training_allowed": {"type": "boolean"},
    "live_allowed": {"type": "boolean"},
    "failure_policy": {"const": "ISOLATE_FAIL_CLOSED"},
    "fallback_behavior": {"const": "BASELINE_UNCHANGED"},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "max_retries": {"type": "integer", "minimum": 0},
    "acceptance_ref": {"type": ["string", "null"]},
    "rollback_target_module_version": {"type": ["string", "null"]},
    "rollback_target_module_set_fingerprint": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"lifecycle": {"const": "ENABLED"}}, "required": ["lifecycle"]},
      "then": {
        "properties": {
          "enabled": {"const": true},
          "acceptance_ref": {"type": "string", "minLength": 1},
          "rollback_target_module_set_fingerprint": {"type": "string", "minLength": 1}
        }
      },
      "else": {"properties": {"enabled": {"const": false}}}
    }
  ],
  "$comment": "Training/live capability still requires a separately accepted governance policy; this schema only defines the generic manifest shape."
}
